<?xml version="1.0" encoding="utf-8"?>
<!--
    4x2 katakli "1351" haydovchi dashboard vidjeti. `updatePeriodMillis`
    30 daqiqa — bu Android'ning o'zi ruxsat beradigan eng qisqa oraliq
    (bundan tezroq deklarativ so'rash mumkin emas); haqiqiy tezroq
    yangilanish ilova push/foreground orqali `updateAll()`ni to'g'ridan-to'g'ri
    chaqirganda sodir bo'ladi (DriverDashboardWidget.kt).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@android:layout/list_content" />
